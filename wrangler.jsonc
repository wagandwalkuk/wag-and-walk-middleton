{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wag-and-walk-middleton-website",
  "compatibility_date": "2026-06-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.js"
}
