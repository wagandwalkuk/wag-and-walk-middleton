{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wag-and-walk-middleton-website",
  "compatibility_date": "2026-06-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.js",
  "vars": {
    "HUB_BASE_URL": "https://hub.wagandwalk.uk"
  },
  "routes": [
    {
      "pattern": "www.wagandwalk.uk/*",
      "zone_name": "wagandwalk.uk"
    },
    {
      "pattern": "wagandwalk.uk/*",
      "zone_name": "wagandwalk.uk"
    },
    {
      "pattern": "wagandwalk.uk",
      "zone_name": "wagandwalk.uk",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "www.wagandwalk.uk",
      "zone_name": "wagandwalk.uk",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ]
}
